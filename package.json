  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "node-telegram-bot-api": "^0.64.0",
    "playwright": "^1.38.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/projects-scraper.git"
  },
  "bugs": {
