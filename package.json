{
  "name": "scrapper-projects",
  "version": "1.0.0",
  "description": "A web scraper for projects.co.id with Telegram notifications and SQLite storage",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "NODE_ENV=development node app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "playwright install",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json}\""
  },
  "keywords": [
    "scraper",
    "playwright",
    "telegram",
    "sqlite",
    "projects.co.id"
  ],
  "author": "",
